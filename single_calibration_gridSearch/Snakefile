from pathlib import Path

def build_status_targets(paths, require_model_existing=True, label=""):
    models_listed = len(paths)
    resolved = [path_to_model(raw) for raw in paths]
    existing = [mp for mp in resolved if (mp is not None and (not require_model_existing or Path(mp).exists()))]

    outs = []           # only the missing ones go here → scheduled
    found = 0           # existing calibrations

    for mp in existing:
        mp = Path(mp)
        status_path = mp.parent / "calibration_npar2" / "mistag" / ".status.txt"
        if status_path.exists():
            found += 1
        else:
            outs.append(status_path)

    print(f"[{label}] models_listed={models_listed} | models_found={len(existing)} | "
          f"found_calibrations={found} | calibrations_left={len(outs)}")

    return outs



