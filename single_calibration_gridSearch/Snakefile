rule calibrate_tagger:
    input:
        model = join(modified_MC,
                     'savedModels/{sample_type,(withUT_MC_2024|noUT_MC_2024)}/'
                     '{decay,(Bs2JpsiPhi|Bu2JpsiK|Bd2JpsiKst|Bd2DmPi|Bs2DsPi)}/'
                     '{tagger,(OSKaon|OSMuon|OSElectron|SSPion|SSProton|SSKaon)}/'
                     '{cut_name}_{balanced}/{features}/{seed}/{config}/{asymmetry_level}/{SPEC}/model.pth'),
        script = join(repo, 'scripts/calibrate_tagger.py'),
    output:
        status = join(modified_MC,
                    'savedModels/{sample_type,(withUT_MC_2024|noUT_MC_2024)}/'
                    '{decay,(Bs2JpsiPhi|Bu2JpsiK|Bd2JpsiKst|Bd2DmPi|Bs2DsPi)}/'
                    '{tagger,(OSKaon|OSMuon|OSElectron|SSPion|SSProton|SSKaon)}/'
                    '{cut_name}_{balanced}/{features}/{seed}/{config}/{asymmetry_level}/{SPEC}/'
                    'calibration_npar2/mistag/.status.txt'),
    log:
        join(modified_MC,
             'savedModels/{sample_type,(withUT_MC_2024|noUT_MC_2024)}/'
             '{decay,(Bs2JpsiPhi|Bu2JpsiK|Bd2JpsiKst|Bd2DmPi|Bs2DsPi)}/'
             '{tagger,(OSKaon|OSMuon|OSElectron|SSPion|SSProton|SSKaon)}/'
             '{cut_name}_{balanced}/{features}/{seed}/{config}/{asymmetry_level}/{SPEC}/'
             'calibration_npar2/mistag/{tagger}_Calibration.log')
    params:
        model_path = lambda wc: join(modified_MC,
                                     f"savedModels/{wc.sample_type}/{wc.decay}/{wc.tagger}/"
                                     f"{wc.cut_name}_{wc.balanced}/{wc.features}/{wc.seed}/{wc.config}/{wc.asymmetry_level}/{wc.SPEC}/"),
        sim_flag = lambda wc: ('--simulation' if 'MC' in wc.sample_type else ''),
        calibration_plot = join(modified_MC,
                                'savedModels/{sample_type,(withUT_MC_2024|noUT_MC_2024)}/'
                                '{decay,(Bs2JpsiPhi|Bu2JpsiK|Bd2JpsiKst|Bd2DmPi|Bs2DsPi)}/'
                                '{tagger,(OSKaon|OSMuon|OSElectron|SSPion|SSProton|SSKaon)}/'
                                '{cut_name}_{balanced}/{features}/{seed}/{config}/{asymmetry_level}/{SPEC}/'
                                'calibration_npar2/mistag/{tagger}_Calibration.pdf'),
        calibration_results_json = join(modified_MC,
                    'savedModels/{sample_type,(withUT_MC_2024|noUT_MC_2024)}/'
                    '{decay,(Bs2JpsiPhi|Bu2JpsiK|Bd2JpsiKst|Bd2DmPi|Bs2DsPi)}/'
                    '{tagger,(OSKaon|OSMuon|OSElectron|SSPion|SSProton|SSKaon)}/'
                    '{cut_name}_{balanced}/{features}/{seed}/{config}/{asymmetry_level}/{SPEC}/'
                    'calibration_npar2/mistag/taggingInfo_mistag.json'),
    resources:
        MaxRunHours = 4,
#memory requirment
        mem_mb = 50000
    shell:
        r"""
        # Run calibration; allow non-zero exit (non-convergence) but keep logs.
        python {input.script} \
            --model_path "{params.model_path}" \
            --tagger {wildcards.tagger} \
            --features {wildcards.features} \
            --repo {repo} \
            --decayType {wildcards.decay} \
            {params.sim_flag} \
            &> {log} || true

        # Mark what we actually got
        JSON_OK="missing"
        PLOT_OK="missing"
        if [ -s "{params.calibration_results_json}" ]; then JSON_OK="ok"; fi
        if [ -s "{params.calibration_plot}" ]; then PLOT_OK="ok"; fi

        # Write/refresh status file (use subshell to avoid literal braces)
        status_dir="$(dirname "{output.status}")"
        mkdir -p "$status_dir"
        (
        echo "timestamp=$(date -Is)"
        echo "calibration_results_json={params.calibration_results_json} [$JSON_OK]"
        echo "calibration_plot={params.calibration_plot} [$PLOT_OK]"
        ) > "{output.status}"
        """



rule pick_best_candidates:
    # Ensure we attempt all calibrations first (even if some don’t converge)
    input:
        CALIB_STATUS_TARGETS
    output:
        out = BEST_JSON_OUT
    params:
        # getOptimized.py will scan model tree and ignore missing calibration-results JSONs
        model_prePath = join(modified_MC, f"savedModels/{SAMPLE_TYPE}"),
        cut           = CUT,
        features      = FEATURES,
        asym          = ASYM,
        out_dir       = join(repo, 'best_tagger_candidates'),
        script        = join(repo, 'scripts/getOptimized.py'),
        interval      = FILE_INTERVAL,
        maximize      = MAZIMIZE,   # could also be "ratio"
        outfile       = OUTFILE
    
    shell:
        r"""
        python {params.script} \
            --model_prePath "{params.model_prePath}" \
            --cut "{params.cut}" \
            --features "{params.features}" \
            --outputPath "{params.out_dir}"
            --file_interval "configs/hyperpar_intervals_larger"
            --outfile "candidateTaggers_overall_large"
            --maximize "nominal
        """

