import re

try:
    raw_MC = config['RAW_MC']     # not used, but kept for completeness
    modified_MC = config['MODIFIED_MC']
    repo = config['REPO']
except Exception as e:
    raise RuntimeError("Make sure to specify snakemake config: RAW_MC, MODIFIED_MC, REPO") from e

from os.path import join
from pathlib import Path
import re

# --- read list files (tolerant of stray quotes/whitespace)
def read_generated_paths(file):
    p = Path(file)
    if not p.exists():
        return []
    out = []
    for line in p.read_text().splitlines():
        s = line.strip().strip('"').strip()
        if s:
            out.append(s)
    return out

# --- tagger extraction (used to name the output)
_TAG_RE = re.compile(r'/(OSKaon|OSMuon|OSElectron|SSPion|SSProton|SSKaon)/')
TAGGERS = {"OSKaon","OSMuon","OSElectron","SSPion","SSProton","SSKaon"}

def infer_tagger(path_str: str):
    p = Path(path_str)
    for part in p.parts:
        if part in TAGGERS:
            return part
    m = _TAG_RE.search(path_str)
    return m.group(1) if m else None

# --- normalize any acceptable artifact to its model.pth
def path_to_model(path_str: str):
    p = Path(path_str)
    if p.name == "model.pth":
        return p
    if p.name == "ROC_TRAIN_VAL.pdf":
        return p.with_name("model.pth")
    if p.is_dir():
        return p / "model.pth"
    return None

def build_targets(paths, npar=2, func="mistag", require_existing=True, label=""):
    outs, kept, skipped = [], 0, 0
    for raw in paths:
        mp = path_to_model(raw)
        if mp is None:
            skipped += 1
            continue
        if require_existing and not mp.exists():
            skipped += 1
            continue
        tagger = infer_tagger(str(mp))
        if not tagger:
            skipped += 1
            continue
        outs.append(str(mp).replace(
            "model.pth",
            f"calibration_npar{npar}/{func}/{tagger}_Calibration.pdf"
        ))
        kept += 1
    print(f"[calibration:{func}{'|'+label if label else ''}] kept={kept} skipped={skipped} from {len(paths)}")
    return outs

generated_paths_SSPion     = read_generated_paths(join(repo, 'paths_for_snakemake/generated_paths_SSPion.txt'))
generated_paths_SSKaon     = read_generated_paths(join(repo, 'paths_for_snakemake/generated_paths_SSKaon.txt'))
generated_paths_SSProton   = read_generated_paths(join(repo, 'paths_for_snakemake/generated_paths_SSProton.txt'))
generated_paths_OSKaon     = read_generated_paths(join(repo, 'paths_for_snakemake/generated_paths_OSKaon.txt'))
generated_paths_OSElectron = read_generated_paths(join(repo, 'paths_for_snakemake/generated_paths_OSElectron.txt'))
generated_paths_OSMuon     = read_generated_paths(join(repo, 'paths_for_snakemake/generated_paths_OSMuon.txt'))

CALIB_TARGETS  = build_targets(generated_paths_SSPion,     npar=2, func="mistag", require_existing=True, label="SSPion")
CALIB_TARGETS += build_targets(generated_paths_SSKaon,     npar=2, func="mistag", require_existing=True, label="SSKaon")
CALIB_TARGETS += build_targets(generated_paths_SSProton,   npar=2, func="mistag", require_existing=True, label="SSProton")
CALIB_TARGETS += build_targets(generated_paths_OSKaon,     npar=2, func="mistag", require_existing=True, label="OSKaon")
CALIB_TARGETS += build_targets(generated_paths_OSElectron, npar=2, func="mistag", require_existing=True, label="OSElectron")
CALIB_TARGETS += build_targets(generated_paths_OSMuon,     npar=2, func="mistag", require_existing=True, label="OSMuon")

CALIB_TARGETS += build_targets(generated_paths_SSPion,     npar=2, func="logit", require_existing=True, label="SSPion")
CALIB_TARGETS += build_targets(generated_paths_SSKaon,     npar=2, func="logit", require_existing=True, label="SSKaon")
CALIB_TARGETS += build_targets(generated_paths_SSProton,   npar=2, func="logit", require_existing=True, label="SSProton")
CALIB_TARGETS += build_targets(generated_paths_OSKaon,     npar=2, func="logit", require_existing=True, label="OSKaon")
CALIB_TARGETS += build_targets(generated_paths_OSElectron, npar=2, func="logit", require_existing=True, label="OSElectron")
CALIB_TARGETS += build_targets(generated_paths_OSMuon,     npar=2, func="logit", require_existing=True, label="OSMuon")

CALIB_TARGETS += build_targets(generated_paths_SSPion,     npar=3, func="logit", require_existing=True, label="SSPion")
CALIB_TARGETS += build_targets(generated_paths_SSKaon,     npar=3, func="logit", require_existing=True, label="SSKaon")
CALIB_TARGETS += build_targets(generated_paths_SSProton,   npar=3, func="logit", require_existing=True, label="SSProton")
CALIB_TARGETS += build_targets(generated_paths_OSKaon,     npar=3, func="logit", require_existing=True, label="OSKaon")
CALIB_TARGETS += build_targets(generated_paths_OSElectron, npar=3, func="logit", require_existing=True, label="OSElectron")
CALIB_TARGETS += build_targets(generated_paths_OSMuon,     npar=3, func="logit", require_existing=True, label="OSMuon")

CALIB_TARGETS += build_targets(generated_paths_SSPion,     npar=3, func="mistag", require_existing=True, label="SSPion")
CALIB_TARGETS += build_targets(generated_paths_SSKaon,     npar=3, func="mistag", require_existing=True, label="SSKaon")
CALIB_TARGETS += build_targets(generated_paths_SSProton,   npar=3, func="mistag", require_existing=True, label="SSProton")
CALIB_TARGETS += build_targets(generated_paths_OSKaon,     npar=3, func="mistag", require_existing=True, label="OSKaon")
CALIB_TARGETS += build_targets(generated_paths_OSElectron, npar=3, func="mistag", require_existing=True, label="OSElectron")
CALIB_TARGETS += build_targets(generated_paths_OSMuon,     npar=3, func="mistag", require_existing=True, label="OSMuon")


print(f"[calibration] scheduling {len(CALIB_TARGETS)} targets (after filtering)")


rule all:
    input: CALIB_TARGETS

rule calibrate_tagger:
    input:
        model = join(modified_MC,
                     'savedModels/{sample_type,(withUT_MC_2024|noUT_MC_2024)}/'
                     '{decay,(Bs2JpsiPhi|Bu2JpsiK|Bd2JpsiKst|Bd2DmPi|Bs2DsPi)}/'
                     '{tagger,(OSKaon|OSMuon|OSElectron|SSPion|SSProton|SSKaon)}/'
                     '{cut_name}_{balanced}/{features}/{seed}/{config}/{asymmetry_level}/model.pth'),
        script = join(repo, 'scripts/calibrate_tagger.py'),
    output:
        plot = join(modified_MC,
                    'savedModels/{sample_type,(withUT_MC_2024|noUT_MC_2024)}/'
                    '{decay,(Bs2JpsiPhi|Bu2JpsiK|Bd2JpsiKst|Bd2DmPi|Bs2DsPi)}/'
                    '{tagger,(OSKaon|OSMuon|OSElectron|SSPion|SSProton|SSKaon)}/'
                    '{cut_name}_{balanced}/{features}/{seed}/{config}/{asymmetry_level}/'
                    'calibration_npar{npar}/{func,(mistag|logit)}/{tagger}_Calibration.pdf'),
    log:
        join(modified_MC,
             'savedModels/{sample_type,(withUT_MC_2024|noUT_MC_2024)}/'
             '{decay,(Bs2JpsiPhi|Bu2JpsiK|Bd2JpsiKst|Bd2DmPi|Bs2DsPi)}/'
             '{tagger,(OSKaon|OSMuon|OSElectron|SSPion|SSProton|SSKaon)}/'
             '{cut_name}_{balanced}/{features}/{seed}/{config}/{asymmetry_level}/'
             'calibration_npar{npar}/{func}/{tagger}_Calibration.log')
    resources:
        #mem_mb = 20000,
        OnExitRemove = "ExitCode == 0 || ExitCode == 1",
        MaxRunHours = 4,
        #request_disk = 102400
    params:
        model_path = lambda wc: join(modified_MC,
                                     f"savedModels/{wc.sample_type}/{wc.decay}/{wc.tagger}/"
                                     f"{wc.cut_name}_{wc.balanced}/{wc.features}/{wc.seed}/{wc.config}/{wc.asymmetry_level}"),
        sim_flag = lambda wc: ('--simulation' if 'MC' in wc.sample_type else '')
    shell:
        r"""
        python {input.script} \
            --model_path "{params.model_path}" \
            --tagger {wildcards.tagger} \
            --features {wildcards.features} \
            --repo {repo} \
            --decayType {wildcards.decay} \
            --npar {wildcards.npar} \
            --function {wildcards.func} \
            {params.sim_flag} \
            &> {log}
        """
