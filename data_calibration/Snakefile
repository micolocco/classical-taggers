    'Bu2JpsiK': [join(raw_data, 'Bu2JpsiK', os.path.basename(f)) for f in files_s24c2],
    #'Bd2JpsiKst': [join(raw_data, '1_raw/Bd2JpsiKst', os.path.basename(f)) for f in files_s24c2]
}

print(ntuples_raw)
