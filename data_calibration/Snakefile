#phis ntuples are huge, they contain all the decays, so this first rule is to populate 2_added_features directory with only the interesting decay
rule add_features_data:
    input:
        script = join(repo, 'scripts/adding_features_v2.py'),
        raw = join(raw_path, '{id}.root')
    log: join(out, 'Data/{sample_type,(withUT_MC_2024|noUT_MC_2024)}/2_added_features/{decay,(Bs2JpsiPhi|Bu2JpsiK|Bd2JpsiKst|Bd2DmPi|Bs2DsPi)}/.{id,.*}.log')
    output:
        root =join(out, 'Data/{sample_type}/2_added_features/{decay}/{id}.root')
    run:
        tree = find_tree_name(wildcards.decay)
        cmd = [
            'python', input.script,
            '--raw ', input.raw,
            '--output {output}',
            '--evtType {wildcards.decay}',
            '--treename', tree,
            '--data_calib',
            '&> {log}',
        ]
        shell(' '.join(cmd))

rule add_selection_data:
    input:
        script = join(repo, 'scripts/preSelections.py'),
        added_features = join(out, 'Data/{sample_type}/2_added_features/{decay}/{id}.root'), # Raw from Jpsi are made by the rule above, with added features run already
    output: join(out, 'Data/{sample_type,(withUT_MC_2024|noUT_MC_2024)}/3_selected/{decay,(Bs2JpsiPhi|Bu2JpsiK|Bd2JpsiKst|Bd2DmPi|Bs2DsPi)}/{tagger, (OSKaon|OSMuon|OSElectron|SSPion|SSProton|SSKaon)}/{cut_name}/{features}/{id,.*}.root'),
    log : join(out, 'Data/{sample_type,(withUT_MC_2024|noUT_MC_2024)}/3_selected/{decay,(Bs2JpsiPhi|Bu2JpsiK|Bd2JpsiKst|Bd2DmPi|Bs2DsPi)}/{tagger, (OSKaon|OSMuon|OSElectron|SSPion|SSProton|SSKaon)}/{cut_name}/{features}/.{id,.*}.log')
    run:
        cmd = [
            'python', input.script,
            '--added_features {input.added_features}',
            '--output {output}',
            '--cut_file', join(repo, 'cuts/{wildcards.sample_type}/{wildcards.decay}/{wildcards.tagger}/{wildcards.cut_name}.txt'),
            '--tagger {wildcards.tagger}',
            '--features {wildcards.features}',
            '--data_calib',
            '--repo', repo,
            '&> {log}',
        ]
        shell(' '.join(cmd))

rule add_tagDec_data:
    input:
        script = join(repo, 'scripts/adding_tagDec.py'),
        selected = join(out, 'Data/{sample_type}/3_selected/{decay}/{tagger}/{cut_name}/{features}/{id}')
    output:
        root = join(out, 'Data/{sample_type,(withUT_MC_2024|noUT_MC_2024)}/4_tagged/{decay,(Bs2JpsiPhi|Bu2JpsiK|Bd2JpsiKst|Bd2DmPi|Bs2DsPi)}/{tagger,(OSKaon|OSMuon|OSElectron|SSPion|SSProton|SSKaon)}/{cut_name}/{features}/{id}'),
    log:
        join(out, 'Data/{sample_type,(withUT_MC_2024|noUT_MC_2024)}/4_tagged/{decay,(Bs2JpsiPhi|Bu2JpsiK|Bd2JpsiKst|Bd2DmPi|Bs2DsPi)}/{tagger,(OSKaon|OSMuon|OSElectron|SSPion|SSProton|SSKaon)}/{cut_name}/{features}/{id}.log'),
    params:
        modelPrePath = lambda wildcards: join(out.replace("ntuples","Micol_trainings"), f'Data/savedModels/{wildcards.sample_type}/{extract_decay(wildcards.tagger)}/{wildcards.tagger}/{wildcards.cut_name}/{wildcards.features}'),
        taggedDataPath = join(out, 'Data/{sample_type,(withUT_MC_2024|noUT_MC_2024)}/4_tagged/{decay,(Bs2JpsiPhi|Bu2JpsiK|Bd2JpsiKst|Bd2DmPi|Bs2DsPi)}/{tagger,(OSKaon|OSMuon|OSElectron|SSPion|SSProton|SSKaon)}/{cut_name}/{features}/'),
    run:
        print(f"Processing file: {wildcards.id}")
        print(f"Selected input file: {input.selected}")

        cmd = [
            'python', input.script,
            '--selected {input.selected}',
            '--cut {wildcards.cut_name}',
            '--taggedData {output.root}',  
            '--modelPrePath {params.modelPrePath}',
            '--decayType {wildcards.decay}', # Decay used for evaluating the tagger
            '--tagger {wildcards.tagger}',
            '--features {wildcards.features}',
            '--repo', repo,
            '--data_calib',
            '&> {log}'
        ]
        shell(' '.join(cmd))


rule sim_sweights:
    input:
        script = join(repo, 'data_calibration/sweights.py'),
    output:
        mc_res = join(out, 'Data/savedModels/withUT_MC_2024/{decay}/data_calib_output/mc_fit/mc_res.json'),
    log:
        join(out, 'Data/savedModels/withUT_MC_2024/{decay}/data_calib_output/mc_fit/mc_log.log'),
    params:
        sim_files = join(MC, '{decay}/'),
    run:
        tree = find_tree_name(wildcards.decay)
        out_path = os.path.dirname(os.path.dirname(output.mc_res))

        cmd = [
            'python {input.script}',
            '--sim_files {params.sim_files}*.root',
            '--range {lowerMass} {upperMass}', 
            '--treename', tree,
            '--simulation',
            '--output ', out_path,
            '--decayType {wildcards.decay}',
            '&> {log}'
        ]
        shell(' '.join(cmd))        

def taggedPaths(decay):
    taggers = taggers_conf[decay]
    ids = [os.path.basename(i) for i in raw_data[decay]]
    prepath = join(out, f'Data/withUT_MC_2024/4_tagged/{decay}')
    paths = expand(join(prepath, '{tagger}/notSamePV_noOSP/union_PROBNN/{id}'), tagger = taggers, id = ids)
    return paths

rule data_sweights:
    input:
        script = join(repo, 'data_calibration/sweights.py'),
        mc_res = join(out, 'Data/savedModels/withUT_MC_2024/{decay}/data_calib_output/mc_fit/mc_res.json'),
        taggedPaths = lambda wildcards: taggedPaths(decay=wildcards.decay),
        
    output:
        data_res = join(out, 'Data/savedModels/withUT_MC_2024/{decay}/data_calib_output/data_fit/data_res.json'),
        sweights = join(out, 'Data/savedModels/withUT_MC_2024/{decay}/data_calib_output/data_fit/sweights.root'),

    log:
        join(out, 'Data/savedModels/withUT_MC_2024/{decay}/data_calib_output/data_fit/data_log.log'),
    params:
        sim_files = join(MC, '{decay}/'),
        tagged_prePath = join(out, 'Data/withUT_MC_2024/4_tagged/'),
        taggers = lambda wildcards: ' '.join(taggers_conf[wildcards.decay]),
        # tree = lambda wildcards: find_tree_name(wildcards.decay),
    run:
        out_path = os.path.dirname(os.path.dirname(output.data_res))
        cmd = [
            'python {input.script}',
            '--sim_files {params.sim_files}*.root',
            '--range {lowerMass} {upperMass}', 
            '--treename "DecayTree;1"', ##Maybe different in different files? might has to change
            # 'treename {params.tree}',
            '--output', out_path,
            '--decayType {wildcards.decay}',
            '--features union_PROBNN',
            '--sim_fit {input.mc_res}',
            '--tagged_prePath {params.tagged_prePath}',
            '--cut notSamePV_noOSP',
            '--tagger {params.taggers}',
            '&> {log}'
        ]
        shell(' '.join(cmd))        
        	
rule data_calib:
    input:
        script = join(repo, 'data_calibration/data_calib.py'),
        sweights = join(out, 'Data/savedModels/withUT_MC_2024/{decay}/data_calib_output/data_fit/sweights.root'),
    output:
        join(out, 'Data/savedModels/withUT_MC_2024/{decay}/data_calib_output/combinations/Run3/Total_combination.json')
    log:
        join(out, 'Data/savedModels/withUT_MC_2024/{decay}/data_calib_output/combinations/Run3/Total_combination.log'),
    params:
        taggers = lambda wildcards: ' '.join(taggers_conf[wildcards.decay]),
        out_path = join(out, 'Data/savedModels/withUT_MC_2024/{decay}/data_calib_output/')

    run:
        cmd = [
            'python {input.script}',
            '--input_file {input.sweights}',
            '--decayType {wildcards.decay}',
            '--tagger {params.taggers}',
            '--outputPath {params.out_path}', 
            '--features union_PROBNN',
            '--combinationName Total_combination',
            '--cut notSamePV_noOSP',
            '&> {log}'
        ]
        shell(' '.join(cmd))   
