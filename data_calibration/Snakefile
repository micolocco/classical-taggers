#phis ntuples are huge, they contain all the decays, so this first rule is to populate 1_raw directory with only the interesting decay
RAW_SETTINGS = {
    "Bu2JpsiK": "root://eoslhcb.cern.ch//eos/lhcb/grid/prod/lhcb/anaprod/lhcb/LHCb/Collision24/DATA24.ROOT/00266999/0000/",
